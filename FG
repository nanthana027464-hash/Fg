-- โหลด Rayfield UI Library
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

-- สร้างหน้าต่างหลัก (UI Window)
local Window = Rayfield:CreateWindow({
   Name = "Multi-Function Hack UI",
   LoadingTitle = "กำลังโหลดระบบ...",
   LoadingSubtitle = "by Assistant",
   ConfigurationSaving = {
      Enabled = false
   },
   Discord = {
      Enabled = false
   },
   KeySystem = false
})

-- สร้าง แถบเมนู (Tabs)
local PlayerTab = Window:CreateTab("ตัวละคร (Player)", 4483362458)
local VehicleTab = Window:CreateTab("ยานพาหนะ (Vehicle)", 4483362458)
local WorldTab = Window:CreateTab("ทั่วไป (World)", 4483362458)

--------------------------------------------------------------------
-- 1. ระบบตัวละคร (Player Settings)
--------------------------------------------------------------------
local LocalPlayer = game.Players.LocalPlayer

-- ตัวแปรระบบความเร็ววิ่ง
local DefaultSpeed = 16
local CustomSpeed = 16
local SpeedEnabled = false

local function UpdateSpeed()
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        if SpeedEnabled then
            LocalPlayer.Character.Humanoid.WalkSpeed = CustomSpeed
        else
            LocalPlayer.Character.Humanoid.WalkSpeed = DefaultSpeed
        end
    end
end

-- Toggle เปิด/ปิด ความเร็ววิ่ง
PlayerTab:CreateToggle({
   Name = "เปิด / ปิด ความเร็ววิ่ง",
   CurrentValue = false,
   Flag = "SpeedToggle",
   Callback = function(Value)
      SpeedEnabled = Value
      UpdateSpeed()
   end,
})

-- Slider ปรับความเร็ววิ่ง
PlayerTab:CreateSlider({
   Name = "ปรับระดับความเร็ว (WalkSpeed)",
   Range = {16, 500},
   Increment = 1,
   Suffix = " Speed",
   CurrentValue = 16,
   Flag = "SpeedSlider",
   Callback = function(Value)
      CustomSpeed = Value
      UpdateSpeed()
   end,
})

--------------------------------------------------------------------
-- 2. ระบบป้องกันการโจมตี (GodMode / Anti-Damage)
--------------------------------------------------------------------
local GodModeEnabled = false

PlayerTab:CreateToggle({
   Name = "เปิด / ปิด ป้องกันการโจมตี (God Mode)",
   CurrentValue = false,
   Flag = "GodModeToggle",
   Callback = function(Value)
      GodModeEnabled = Value
      if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
         local hum = LocalPlayer.Character.Humanoid
         if GodModeEnabled then
            -- ตั้งค่าสถานะเป็นอมตะเบื้องต้น
            hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
         else
            hum:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
         end
      end
   end,
})

-- Loop รักษาสุขภาพตัวละคร (Anti-Damage Loop)
task.spawn(function()
    while task.wait(0.1) do
        if GodModeEnabled and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
            local hum = LocalPlayer.Character.Humanoid
            if hum.Health < hum.MaxHealth then
                hum.Health = hum.MaxHealth
            end
        end
    end
end)

--------------------------------------------------------------------
-- 3. ระบบปรับความเร็วรถ (Vehicle Speed)
--------------------------------------------------------------------
local VehicleSpeedEnabled = false
local VehicleCustomSpeed = 100

VehicleTab:CreateToggle({
   Name = "เปิด / ปิด ระบบปรับความเร็วรถ",
   CurrentValue = false,
   Flag = "VehicleSpeedToggle",
   Callback = function(Value)
      VehicleSpeedEnabled = Value
   end,
})

VehicleTab:CreateSlider({
   Name = "ความเร็วรถ (Vehicle Speed)",
   Range = {20, 500},
   Increment = 5,
   Suffix = " Speed",
   CurrentValue = 100,
   Flag = "VehicleSpeedSlider",
   Callback = function(Value)
      VehicleCustomSpeed = Value
   end,
})

-- Loop ปรับความเร็วรถขณะขับ
task.spawn(function()
    while task.wait(0.1) do
        if VehicleSpeedEnabled and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
            local hum = LocalPlayer.Character.Humanoid
            if hum.SeatPart and hum.SeatPart:IsA("VehicleSeat") then
                hum.SeatPart.MaxSpeed = VehicleCustomSpeed
                hum.SeatPart.Torque = VehicleCustomSpeed * 10
            end
        end
    end
end)

--------------------------------------------------------------------
-- 4. ระบบหยิบของไว (Fast Proximity Prompt / Instagrab)
--------------------------------------------------------------------
local FastPromptEnabled = false
local OriginalHoldDurations = {}

WorldTab:CreateToggle({
   Name = "เปิด / ปิด หยิบของไว (Instant Interact)",
   CurrentValue = false,
   Flag = "FastPromptToggle",
   Callback = function(Value)
      FastPromptEnabled = Value
      for _, prompt in ipairs(workspace:GetDescendants()) do
         if prompt:IsA("ProximityPrompt") then
            if FastPromptEnabled then
               if not OriginalHoldDurations[prompt] then
                  OriginalHoldDurations[prompt] = prompt.HoldDuration
               end
               prompt.HoldDuration = 0
            else
               if OriginalHoldDurations[prompt] then
                  prompt.HoldDuration = OriginalHoldDurations[prompt]
               end
            end
         end
      end
   end,
})

-- ตรวจจับไอเทม/ProximityPrompt ที่เกิดขึ้นใหม่ในแมพ
workspace.DescendantAdded:Connect(function(descendant)
    if descendant:IsA("ProximityPrompt") and FastPromptEnabled then
        OriginalHoldDurations[descendant] = descendant.HoldDuration
        descendant.HoldDuration = 0
    end
end)

--------------------------------------------------------------------
-- ระบบเสริมจัดการเมื่อเกิดใหม่ (Respawn Handler)
--------------------------------------------------------------------
LocalPlayer.CharacterAdded:Connect(function(char)
    char:WaitForChild("Humanoid")
    task.wait(0.5)
    UpdateSpeed()
end)

-- Loop ป้องกันเกมรีเซ็ต WalkSpeed ของตัวละคร
task.spawn(function()
    while task.wait(0.1) do
        if SpeedEnabled and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
            if LocalPlayer.Character.Humanoid.WalkSpeed ~= CustomSpeed then
                LocalPlayer.Character.Humanoid.WalkSpeed = CustomSpeed
            end
        end
    end
end)

